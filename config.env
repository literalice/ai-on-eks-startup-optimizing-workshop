# Workshop configuration. Everything else reads this file.
# Edit, then run bin/prep.sh.
#
# Every value uses ${VAR:-default}, so anything already set in the environment
# wins. That means you can override one setting for a single run --
# GPU_INSTANCE_TYPE=g6.8xlarge bin/bench.sh soci -- without editing the file
# and remembering to put it back.

export REGION="${REGION:-us-west-2}"
export NAME_PREFIX="${NAME_PREFIX:-br-startup}"

export KARPENTER_CLUSTER="${KARPENTER_CLUSTER:-${NAME_PREFIX}-karpenter}"
export AUTOMODE_CLUSTER="${AUTOMODE_CLUSTER:-${NAME_PREFIX}-automode}"

# The instance type every variant runs on. All four variants are pinned to exactly this
# type so nothing in the comparison is explained by hardware.
#
# g6.4xlarge: 1x L4, 16 vCPU, 600 GB NVMe, up to 25 Gbps.
# The vCPU count matters -- SOCI's parallel unpack is CPU-bound, so a 2xlarge
# understates the gain and an 8xlarge overstates it relative to a typical
# inference node. Local NVMe is required, because variants C and D both use it.
export GPU_INSTANCE_TYPE="${GPU_INSTANCE_TYPE:-g6.4xlarge}"

# The measured image. Large, GPU, and readable by any AWS account, so no registry
# credentials and no build step.
#
# Verify the tag still exists before the workshop:
#   aws ecr describe-images --region "$REGION" \
#     --registry-id 763104351884 --repository-name vllm \
#     --query 'sort_by(imageDetails,&imagePushedAt)[-5:].imageTags'
export WORKLOAD_IMAGE="${WORKLOAD_IMAGE:-763104351884.dkr.ecr.${REGION}.amazonaws.com/vllm:0.22.0-gpu-py312-cu130-ubuntu22.04-ec2}"

# Phase 2 (section 4). MODEL_BUCKET comes from `terraform output -raw model_bucket`.
export MODEL_BUCKET="${MODEL_BUCKET:-}"
export MODEL_PREFIX="${MODEL_PREFIX:-Qwen2.5-1.5B-Instruct}"
export MODEL_NAME="${MODEL_NAME:-qwen2.5-1.5b-instruct}"
export MODEL_HF_REPO="${MODEL_HF_REPO:-Qwen/Qwen2.5-1.5B-Instruct}"

# Run:ai Model Streamer concurrency. These are the values Run:ai's own published
# benchmarks found near-optimal on an A10G: concurrency saturates the medium, so
# the right number differs between local disk and S3.
#
# Their figures for Llama-3-8B (15 GB) are worth knowing before you read ours,
# as a sanity check on the order of magnitude:
#   gp3 SSD, default safetensors loader ... 47.99s to load
#   gp3 SSD, streamer at concurrency 16 .. 14.34s  (storage-bound at 1 GiB/s)
#   S3, streamer at concurrency 32 ....... 4.88s
#   end-to-end vLLM readiness: 66.13s (safetensors on gp3) vs 23.18s (S3 stream)
#
# A 1.5B model is roughly a tenth of that, so expect single-digit seconds and a
# proportionally smaller absolute gap. Raise MODEL_HF_REPO to a larger model if
# the difference needs to be visible from the back of the room.
export RUNAI_CONCURRENCY_LOCAL="${RUNAI_CONCURRENCY_LOCAL:-16}"
export RUNAI_CONCURRENCY_S3="${RUNAI_CONCURRENCY_S3:-32}"

# Tokens to request when measuring time to first token. Only the first one is
# timed; the rest just confirm the server is really generating.
export TTFT_MAX_TOKENS="${TTFT_MAX_TOKENS:-64}"

# How long to wait for a pod to reach Ready before calling the run failed.
# A cold baseline pull of a 10+ GB image can legitimately take 10 minutes.
export BENCH_TIMEOUT_SECONDS="${BENCH_TIMEOUT_SECONDS:-1500}"
