#!/usr/bin/env python3
"""A fake kubectl for the rehearsal. Makes no network calls of any kind.

Serves the fixture objects progressively -- rebasing their timestamps onto real
wall-clock time and hiding anything that has not "happened" yet -- so bench.sh,
watch_stages.py and stages.py all run unmodified and the recording shows the real
tools rather than a canned transcript.

REHEARSAL_DIR  fixtures produced by make_fixtures.py
REHEARSAL_SPEED  playback compression; 15 means a 425s run replays in ~28s
"""

import json
import os
import pathlib
import sys
import time
from datetime import datetime, timedelta, timezone

FIXTURES = pathlib.Path(os.environ["REHEARSAL_DIR"])
SPEED = float(os.environ.get("REHEARSAL_SPEED", "15"))
STATE = FIXTURES / ".clock"
BASE = datetime(2026, 9, 11, 5, 0, 0, tzinfo=timezone.utc)

args = sys.argv[1:]


def arg_after(flag):
    return args[args.index(flag) + 1] if flag in args and args.index(flag) + 1 < len(args) else None


def positional_after(verb):
    """The word after a verb, skipping flags and their values."""
    if verb not in args:
        return None
    rest = args[args.index(verb) + 1:]
    out = []
    skip = False
    for token in rest:
        if skip:
            skip = False
            continue
        if token.startswith("-"):
            if "=" not in token and token not in ("--no-headers", "--all-containers", "--ignore-not-found"):
                skip = True
            continue
        out.append(token)
    return out


def arm_from(text):
    """Map a pod name or label selector back onto a fixture directory."""
    if not text:
        return None
    candidates = sorted((p.name for p in FIXTURES.iterdir() if p.is_dir()), key=len, reverse=True)
    cleaned = text.replace("bench-", "").replace("karpenter.sh/nodepool=", "")
    cleaned = cleaned.replace("workshop-variant=", "")
    for name in candidates:
        if name == cleaned or name in text:
            return name
    # bench.sh labels phase-2 pods with the variant C nodepool
    for name in candidates:
        if cleaned and cleaned in name:
            return name
    return None


def clock():
    if not STATE.exists():
        return None
    return json.loads(STATE.read_text())


def set_clock(variant):
    STATE.write_text(json.dumps({"variant": variant, "start": time.time()}))


def sim_now(variant):
    """The simulated clock, started by `apply` and never reset by a read.

    Reads must not touch it. Within one run, different queries resolve to
    different fixture names -- a phase-2 pod is `weights-runai-s3` while its
    NodeClaim selector is the soci pool -- so a read that restarted the clock
    would keep pushing the finish line away and the run would never complete.
    """
    state = clock()
    if not state:
        set_clock(variant)
        state = clock()
    real_start = datetime.fromtimestamp(state["start"], tz=timezone.utc)
    return real_start, (time.time() - state["start"]) * SPEED


def parse(value):
    return datetime.fromisoformat(value.replace("Z", "+00:00"))


def load(variant, filename):
    path = FIXTURES / variant / filename
    return json.loads(path.read_text()) if path.is_file() else {}


def base_offset(variant):
    """Fixture offsets are absolute from BASE; normalise so the pod starts at 0."""
    pod = load(variant, "pod.json")
    created = (pod.get("metadata") or {}).get("creationTimestamp")
    return (parse(created) - BASE).total_seconds() if created else 0.0


def rewrite(obj, variant, real_start, elapsed, zero):
    """Rebase timestamps and drop list entries that have not happened yet.

    Timestamps are rebased 1:1 -- the offsets the tools see are the fixture's real
    offsets, so a 425-second run computes as 425 seconds. Only *visibility* is
    accelerated, by a simulated clock running SPEED times faster than wall time.
    That way the recording builds up quickly while every number on screen is the
    number the fixture describes, rather than a figure divided by a speed factor.
    """
    def offset_of(value):
        return (parse(value) - BASE).total_seconds() - zero

    def rebase(value):
        return (real_start + timedelta(seconds=offset_of(value))).strftime("%Y-%m-%dT%H:%M:%SZ")

    def visible(value):
        return offset_of(value) <= elapsed

    def walk(node):
        if isinstance(node, dict):
            return {k: walk(v) for k, v in node.items()}
        if isinstance(node, list):
            out = []
            for item in node:
                if isinstance(item, dict):
                    stamp = (item.get("lastTransitionTime") or item.get("firstTimestamp")
                             or item.get("lastTimestamp"))
                    if stamp and not visible(stamp):
                        continue
                out.append(walk(item))
            return out
        if isinstance(node, str) and len(node) == 20 and node.endswith("Z") and node[4:5] == "-":
            try:
                return rebase(node)
            except ValueError:
                return node
        return node

    result = walk(obj)

    # Hide container states whose start has not arrived.
    status = result.get("status") or {}
    for key in ("containerStatuses", "initContainerStatuses"):
        for entry in status.get(key) or []:
            state = entry.get("state") or {}
            for phase in ("running", "terminated"):
                block = state.get(phase)
                if block and block.get("startedAt"):
                    original = (obj.get("status") or {}).get(key, [{}])[0].get("state", {}).get(phase, {})
                    if original.get("startedAt") and not visible(original["startedAt"]):
                        state.pop(phase, None)
                        state["waiting"] = {"reason": "ContainerCreating"}
                    elif phase == "terminated" and original.get("finishedAt") and not visible(original["finishedAt"]):
                        block.pop("finishedAt", None)
    return result


NODES_WIDE = """NAME                                       STATUS   ROLES    AGE   VERSION               INTERNAL-IP   OS-IMAGE                                       CONTAINER-RUNTIME
ip-10-0-2-118.us-west-2.compute.internal   Ready    <none>   41m   v1.34.1-eks-1a2b3c4   10.0.2.118    Bottlerocket OS 1.64.0 (aws-k8s-1.34)          containerd://2.1.4
ip-10-0-3-207.us-west-2.compute.internal   Ready    <none>   41m   v1.34.1-eks-1a2b3c4   10.0.3.207    Bottlerocket OS 1.64.0 (aws-k8s-1.34)          containerd://2.1.4"""

NODES_WIDE_AUTOMODE = """NAME                  STATUS   ROLES    AGE   VERSION               INTERNAL-IP   OS-IMAGE                                CONTAINER-RUNTIME
i-0a41c9e2b7d3f5602   Ready    <none>   38m   v1.34.1-eks-1a2b3c4   10.0.1.44     Bottlerocket OS 1.64.0 (aws-k8s-1.34)   containerd://2.1.4"""

NODEPOOLS = """NAME             NODECLASS        NODES   READY   AGE
baseline   baseline   0       True    39m
snapshot   snapshot   0       True    39m
soci       soci       0       True    39m"""


def main():
    # Mutating and setup verbs: accept and stay silent.
    if any(v in args for v in ("apply", "create", "delete", "logs")):
        if "apply" in args:
            manifest = arg_after("-f")
            if manifest and pathlib.Path(manifest).is_file():
                text = pathlib.Path(manifest).read_text()
                for line in text.splitlines():
                    if line.strip().startswith("name:"):
                        podname = line.split(":", 1)[1].strip().strip('"')
                        variant = arm_from(podname)
                        if variant:
                            set_clock(variant)
                        break
        return 0

    if "exec" in args:
        pods = positional_after("exec") or []
        variant = arm_from(pods[0] if pods else None)
        ttft = load(variant, "ttft.json") if variant else {}
        print(json.dumps(ttft) if ttft else json.dumps({"error": "no fixture"}))
        return 0 if ttft else 1

    if "get" not in args:
        return 0

    what = positional_after("get")
    kind = what[0] if what else ""
    name = what[1] if what and len(what) > 1 else None
    selector = arg_after("-l")
    wants_json = "json" in (args[args.index("-o") + 1] if "-o" in args else "")

    if kind == "nodes":
        print(NODES_WIDE_AUTOMODE if "automode" in " ".join(args) else NODES_WIDE)
        return 0

    if kind == "nodepools":
        print(NODEPOOLS)
        return 0

    field_selector = arg_after("--field-selector")
    current = (clock() or {}).get("variant")
    from_args = arm_from(name or selector) or arm_from(field_selector)

    # The in-flight run wins for anything that carries timestamps.
    #
    # Within one phase-2 run the pod resolves to `weights-runai-s3` while its
    # NodeClaim selector is the soci pool, and those two fixtures have unrelated
    # time bases. Serving each from its own fixture normalises them differently and
    # the stage chain comes out interleaved and nonsensical. One run is in flight at
    # a time, so read everything from it.
    variant = current or from_args

    # Except the pre-run existence checks, which are asking about a *pool* before
    # the next run has started. Those must answer from the selector.
    if kind == "nodeclaims" and ("--no-headers" in args or ("-o" in args and args[args.index("-o") + 1] == "name")):
        variant = from_args or current

    if not variant:
        print("{}" if wants_json else "", end="\n" if not wants_json else "")
        return 0

    real_start, elapsed = sim_now(variant)
    zero = base_offset(variant)

    if kind == "pod":
        print(json.dumps(rewrite(load(variant, "pod.json"), variant, real_start, elapsed, zero)))
    elif kind == "nodeclaims":
        obj = load(variant, "nodeclaims.json")
        if "-o" in args and args[args.index("-o") + 1] == "name":
            # reset.sh asks for names; report none so it does not try to delete.
            return 0
        if "--no-headers" in args:
            # Warm check counts lines. A warm variant already has its node.
            if "warm" in variant or "weights" in variant:
                print("nc-1   g6.4xlarge   us-west-2a   ip-10-0-1-5   True   12m")
            return 0
        print(json.dumps(rewrite(obj, variant, real_start, elapsed, zero)))
    elif kind == "events":
        print(json.dumps(rewrite(load(variant, "events.json"), variant, real_start, elapsed, zero)))
    elif kind == "node":
        print(json.dumps(load(variant, "node.json")))
    else:
        print("{}" if wants_json else "")
    return 0


if __name__ == "__main__":
    sys.exit(main())
