# Generated by bin/prep.sh from manifests/{karpenter,automode}/
manifests/rendered/

# Per-run Kubernetes objects and computed results. Keep the directories, not the
# contents -- one participant's numbers must not arrive as another's baseline, and a
# dry run's numbers must not be mistaken for the session's.
raw/*
!raw/.gitkeep
results/*
!results/.gitkeep

# Recording artifacts. These embed account-specific detail -- node names, instance
# IDs, IAM role and bucket names -- so none of it is committed. Publish curated
# numbers in REFERENCE-RESULTS.md instead.
recording/*
!recording/.gitkeep

# Rehearsal scratch: fixtures and the sandbox results they produce. Never commit
# these -- fixture-derived numbers must not end up looking like measurements.
rehearsal/.fixtures/
rehearsal/.sandbox/

# Local mise overrides. These name one operator's AWS profile and account, which
# is nobody else's default.
mise.local.toml

__pycache__/
*.pyc

# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/*.tfvars

.DS_Store
